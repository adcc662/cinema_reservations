# Local virtualenv — deps are rebuilt inside the image from uv.lock
.venv
venv

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Version control & CI
.git
.gitignore
.github

# Secrets & local env — NEVER bake these into the image
.env
.env.*

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
