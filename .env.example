# ---------------------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
# The secrets below are freshly generated dev values — REGENERATE for prod:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Project metadata (shown in the OpenAPI docs) ---
PROJECT_NAME=Cinema Reservations
PROJECT_DESCRIPTION=Cinema seat reservation API
PROJECT_VERSION=0.1.0

# --- Environment & security ---
ENVIRONMENT=development
ALGORITHM=HS256
SECRET_KEY=6a171efd6e2dd2269f6d09c35d7875f0318709ff39b08998de4f7ca83fd1021d
JWT_SECRET_KEY=f7b57ec88da1ef66d8a0922fac09ff43996dda44a50a7a8fc2c852a0264304f1
JWT_REFRESH_SECRET_KEY=0246489443dd6c161b80a707c8fbc995dfe79ef3b77acae1007086bd7bae2ecb

# Token lifetimes (optional — these are the defaults from config.py)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Server ---
SERVER_HOST=http://localhost:8000
SERVER_NAME=cinema-reservations
FRONTEND_VALIDATION_URL=http://localhost:3000/validate

# --- API ---
API_V1_STR=/api/v1
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL) ---
# NOTE: for local runs use localhost. Under docker-compose the api service
# overrides POSTGRES_SERVER to "db" (the service name), so this value is only
# used when you run the app WITHOUT docker.
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cinema_reservations
POSTGRES_PORT=5432
